{
  "name": "domorium-obsidian",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:browser": "node harness/build.mjs && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "openspec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.5",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@domorium/codemirror": "^1.5.1",
    "@domorium/language-service": "^1.5.0",
    "@lezer/highlight": "^1.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
